# Copy to .env and adjust. docker compose reads it automatically.

# Household time zone (IANA name).
TZ=America/New_York

# Port on this machine.
LILYPAD_PORT=8080

# Optional fixed admin password (protects settings, reports and exports).
# Leave empty to have one generated on first start (see `docker compose logs`).
LILYPAD_ADMIN_PASSWORD=

# Recommended: the names you use to reach LilyPad, e.g.
# LILYPAD_ALLOWED_HOSTS=lilypad.home.arpa,192.168.1.20,localhost
LILYPAD_ALLOWED_HOSTS=*

# Only if a reverse proxy rewrites the Host header:
# LILYPAD_ALLOWED_ORIGINS=https://lilypad.example.com
LILYPAD_ALLOWED_ORIGINS=

# IPs of a trusted reverse proxy (for real client IPs and HTTPS detection).
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional self-hosted ntfy (docker compose --profile ntfy up -d)
NTFY_PORT=8081
NTFY_BASE_URL=http://localhost:8081
