{
  "id": "/dash",
  "name": "LilyPad Dash",
  "short_name": "LilyPad Dash",
  "description": "Live LilyPad summary for a wall tablet or monitor.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/dash",
  "scope": "/dash",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#0b0f0d",
  "theme_color": "#0b0f0d",
  "categories": ["health", "lifestyle", "medical"],
  "icons": [
    {"src": "/static/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any"},
    {"src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/static/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable"},
    {"src": "/static/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
