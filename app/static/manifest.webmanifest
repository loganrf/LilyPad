{
  "id": "/",
  "name": "LilyPad",
  "short_name": "LilyPad",
  "description": "Self-hosted infant care tracker: feeds, diapers, vitals, notes and reminders.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0e1411",
